                    ( Imported ( ModuleName "Golden.Uncurry.Test" ) ( Name "alwaysFirst$w" ) )
                  )
                  ( LiteralInt Nothing 9 :| [ LiteralInt Nothing 10 ] )
                ]
              )
            )
            ( Ref Nothing ( Imported ( ModuleName "Prim" ) ( Name "$magicDoRun" ) ) :| [] )
          )
        )
      )
    ]
  }