-- A non-`bind` continuation-passing combinator. The `n < 0` guard keeps it
-- recursive, so the optimizer can neither inline nor beta-collapse it; called
-- with n >= 0 it always takes the else branch, so `withInc a k = k (a + 1)`.
withInc :: Int -> (Int -> Int) -> Int
withInc n k = if n < 0 then withInc (n + 1) k else k (n + 1)

-- A ~300-deep chain of `withInc a (\x -> ...)`: a trailing-lambda continuation
