module Golden.LongBindFlipped.Test where

import Prelude

import Data.Maybe (Maybe(..))
import Effect (Effect)
import Effect.Console (logShow)

inc :: Int -> Maybe Int
inc x = Just (x + 1)

-- A ~300-deep flipped-bind spine built with `=<<` (bindFlipped). `inc` is a
-- named function (not a lambda), so this is NOT a trailing-lambda chain and
-- Strategy A does not fire; the depth is in a value-argument position, so
-- Strategy B flattens it. 300 `inc`s over `Just 1` evaluate to `Just 301`.
compute :: Maybe Int
compute =
